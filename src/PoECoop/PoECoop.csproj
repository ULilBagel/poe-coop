<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PoECoop</AssemblyName>
    <RootNamespace>PoECoop</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.9.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Override on another PC: dotnet build -p:GameDir="..." or a PoECoop.csproj.user file -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/snap/steam/common/.local/share/Steam/steamapps/common/Pillars of Eternity</GameDir>
    <Managed>$(GameDir)/PillarsOfEternity_Data/Managed</Managed>
    <PluginDir>$(GameDir)/BepInEx/plugins/PoECoop</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the SDK build net472 on Linux without Mono installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(Managed)/OEIFormats.dll" Private="false" />
    <Reference Include="$(Managed)/com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.*.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Message Importance="high" Text="Deployed to $(PluginDir)" />
  </Target>
</Project>
